{
  "manifest_version": 3,
  "name": "X Playground",
  "version": "0.1.0",
  "description": "Masks visible engagement counts on X posts while keeping actions clickable.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
